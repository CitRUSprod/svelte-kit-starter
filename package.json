{
    "name": "svelte-kit-starter",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "build:auto": "ADAPTER=auto vite build",
        "start": "PORT=6400 node dist",
        "check-types": "svelte-check --tsconfig tsconfig.json",
        "commit": "git-cz",
        "stylelint": "stylelint --color --allow-empty-input",
        "stylelint:fix": "pnpm stylelint --fix",
        "stylelint:all": "pnpm stylelint \"**/*.{css,svelte}\"",
        "stylelint:fix:all": "pnpm stylelint:all --fix",
        "eslint": "eslint --color --no-error-on-unmatched-pattern",
        "eslint:fix": "pnpm eslint --fix",
        "eslint:all": "pnpm eslint .",
        "eslint:fix:all": "pnpm eslint:all --fix",
        "lint": "pnpm stylelint:all && pnpm eslint:all",
        "format": "pnpm stylelint:fix:all && pnpm eslint:fix:all",
        "validate": "pnpm check-types && pnpm lint",
        "prepare": "husky"
    },
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": "26.12.0",
        "pnpm": "11.20.0"
    },
    "config": {
        "commitizen": {
            "path": "cz-customizable"
        },
        "cz-customizable": {
            "config": "./configs/commits/commitizen.cjs"
        }
    },
    "lint-staged": {
        "*.{css,svelte}": "pnpm stylelint",
        "*.{html,mjml,md,json,y?(a)ml,?([cm])js,ts,svelte}": "pnpm eslint"
    },
    "devDependencies": {
        "@citrus-linting/eslint-config": "1.5.0",
        "@citrus-linting/prettier-config": "1.0.1",
        "@citrus-linting/stylelint-config": "1.1.0",
        "@commitlint/cli": "21.2.3",
        "@commitlint/types": "21.2.3",
        "@iconify/json": "2.2.544",
        "@stylistic/eslint-plugin": "5.10.0",
        "@sveltejs/adapter-auto": "7.0.1",
        "@sveltejs/adapter-node": "5.5.7",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/node": "26.6.5",
        "@types/nprogress": "0.2.0",
        "@unocss/extractor-svelte": "66.11.0",
        "@unocss/preset-wind3": "66.11.0",
        "@unocss/reset": "66.11.0",
        "any-eslint-parser": "1.0.1",
        "commitizen": "4.3.2",
        "cz-customizable": "7.5.4",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-svelte": "3.23.1",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "postcss-html": "2.0.0",
        "prettier": "3.9.10",
        "prettier-plugin-svelte": "4.1.1",
        "stylelint": "17.16.0",
        "stylelint-config-prettier": "9.0.5",
        "stylelint-prettier": "5.0.3",
        "svelte": "5.57.2",
        "svelte-check": "4.7.7",
        "svelte-eslint-parser": "1.9.0",
        "type-fest": "5.10.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "unocss": "66.11.0",
        "unocss-preset-better-nested-colors": "1.0.0",
        "vite": "8.3.4",
        "vite-plugin-dynamic-import": "1.6.0"
    },
    "dependencies": {
        "@segment/ajv-human-errors": "2.2.0",
        "@sinclair/typebox": "0.25.24",
        "@sveltekit-i18n/extension-stores": "3.2.1",
        "ajv": "8.12.0",
        "ajv-formats": "2.1.1",
        "ajv-keywords": "5.1.0",
        "bits-ui": "2.19.5",
        "nprogress": "0.2.0",
        "svelte-local-storage-store": "0.6.4",
        "sveltekit-i18n": "3.4.1",
        "tslib": "2.8.1"
    }
}
